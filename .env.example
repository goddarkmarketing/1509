# Copy to .env and adjust for production (never commit .env)

# Local XAMPP:  APP_URL=/LMS
# Production:    APP_URL=https://wenxinchinese.online
# (If omitted on production, the app auto-detects from the current domain.)
APP_URL=/LMS

DB_HOST=localhost
DB_NAME=wenxin_lms
DB_USER=root
DB_PASS=

# Optional: override SMTP password (admin UI can also set smtp_pass)
SMTP_PASS=

# Optional: override Line Notify token
LINE_NOTIFY_TOKEN=

# Omise payment gateway (secret key — public key in Admin settings)
OMISE_SECRET_KEY=
